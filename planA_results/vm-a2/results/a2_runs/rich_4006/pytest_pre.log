            ("a👩\u200d🔧", [(0, 1, 1), (1, 4, 2)], 3),
            ("a👩\u200d🔧b", [(0, 1, 1), (1, 4, 2), (4, 5, 1)], 4),
            ("⬇", [(0, 1, 1)], 1),
            ("⬇️", [(0, 2, 2)], 2),  # Variation selector, makes it double width
            ("♻", [(0, 1, 1)], 1),
            ("♻️", [(0, 2, 2)], 2),
            ("♻♻️", [(0, 1, 1), (1, 3, 2)], 3),
